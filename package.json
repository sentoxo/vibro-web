{
  "name": "vibro-web",
  "private": true,
  "version": "0.1.1-dev",
  "type": "module",
  "description": "Real-time vibration monitor — web port of the Vibro desktop app",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "golden": "python3 scripts/gen_golden.py"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/w3c-web-serial": "^1.0.9",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
